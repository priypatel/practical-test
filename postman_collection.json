{
  "info": {
    "name": "Order Processing System — Full API Test",
    "description": "Import this file into Postman. Run requests top-to-bottom. Token, product_id, and order_id are captured automatically between requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "product_id", "value": "", "type": "string" },
    { "key": "order_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "1 - Health Checks",
      "item": [
        {
          "name": "Gateway Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));", "pm.test('Service ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"] } }]
        },
        {
          "name": "Auth Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/auth/health", "host": ["{{base_url}}"], "path": ["api", "auth", "health"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Product Service Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/products/health", "host": ["{{base_url}}"], "path": ["api", "products", "health"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Order Service Health",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/orders/health", "host": ["{{base_url}}"], "path": ["api", "orders", "health"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Notification Service Health",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/notifications/health", "host": ["{{base_url}}"], "path": ["api", "notifications", "health"] }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Status 200', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    },
    {
      "name": "2 - Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"secret123\",\n  \"role\": \"user\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api", "auth", "register"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "pm.test('Has token', () => pm.expect(res.token).to.be.a('string'));",
                  "if (res.token) {",
                  "  pm.collectionVariables.set('token', res.token);",
                  "  console.log('Token saved:', res.token.substring(0, 30) + '...');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Has token', () => pm.expect(res.token).to.be.a('string'));",
                  "if (res.token) {",
                  "  pm.collectionVariables.set('token', res.token);",
                  "  console.log('Token refreshed');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login - Wrong Password (expect 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"wrongpassword\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 for wrong password', () => pm.response.to.have.status(401));",
                  "pm.test('Error message present', () => pm.expect(pm.response.json().message).to.include('Invalid'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3 - Products",
      "item": [
        {
          "name": "Create Product",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Headphones\",\n  \"description\": \"Noise-cancelling over-ear headphones\",\n  \"price\": 79.99,\n  \"stock\": 50\n}"
            },
            "url": { "raw": "{{base_url}}/api/products", "host": ["{{base_url}}"], "path": ["api", "products"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "pm.test('Product has _id', () => pm.expect(res._id).to.be.a('string'));",
                  "pm.test('Price correct', () => pm.expect(res.price).to.eql(79.99));",
                  "if (res._id) {",
                  "  pm.collectionVariables.set('product_id', res._id);",
                  "  console.log('Product ID saved:', res._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All Products (Cache MISS)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/products", "host": ["{{base_url}}"], "path": ["api", "products"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns array', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "const cache = pm.response.headers.get('X-Cache');",
                  "console.log('X-Cache header:', cache);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All Products (Cache HIT)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/products", "host": ["{{base_url}}"], "path": ["api", "products"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Cache HIT on second call', () => {",
                  "  const cache = pm.response.headers.get('X-Cache');",
                  "  pm.expect(cache).to.eql('HIT');",
                  "});",
                  "console.log('X-Cache:', pm.response.headers.get('X-Cache'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/products/{{product_id}}", "host": ["{{base_url}}"], "path": ["api", "products", "{{product_id}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Correct product returned', () => pm.expect(pm.response.json()._id).to.eql(pm.collectionVariables.get('product_id')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 69.99,\n  \"stock\": 40\n}"
            },
            "url": { "raw": "{{base_url}}/api/products/{{product_id}}", "host": ["{{base_url}}"], "path": ["api", "products", "{{product_id}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Price updated', () => pm.expect(pm.response.json().price).to.eql(69.99));",
                  "pm.test('Stock updated', () => pm.expect(pm.response.json().stock).to.eql(40));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Products After Update (Cache MISS - invalidated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/products", "host": ["{{base_url}}"], "path": ["api", "products"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Cache MISS after write (cache invalidated)', () => {",
                  "  const cache = pm.response.headers.get('X-Cache');",
                  "  pm.expect(cache).to.eql('MISS');",
                  "});",
                  "console.log('X-Cache after update:', pm.response.headers.get('X-Cache'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4 - Orders",
      "item": [
        {
          "name": "Create Order (with Idempotency Key)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "X-Idempotency-Key", "value": "order-idem-key-001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{product_id}}\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": { "raw": "{{base_url}}/api/orders", "host": ["{{base_url}}"], "path": ["api", "orders"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const res = pm.response.json();",
                  "pm.test('Order confirmed', () => pm.expect(res.status).to.eql('confirmed'));",
                  "pm.test('Total amount correct', () => pm.expect(res.totalAmount).to.eql(139.98));",
                  "pm.test('Product name snapshotted', () => pm.expect(res.items[0].name).to.eql('Wireless Headphones'));",
                  "pm.test('Idempotency key saved', () => pm.expect(res.idempotencyKey).to.eql('order-idem-key-001'));",
                  "if (res._id) {",
                  "  pm.collectionVariables.set('order_id', res._id);",
                  "  console.log('Order ID saved:', res._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Order - DUPLICATE (expect 409)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "X-Idempotency-Key", "value": "order-idem-key-001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{product_id}}\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": { "raw": "{{base_url}}/api/orders", "host": ["{{base_url}}"], "path": ["api", "orders"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 409 - Duplicate prevented', () => pm.response.to.have.status(409));",
                  "pm.test('Existing order returned', () => pm.expect(pm.response.json().order).to.be.an('object'));",
                  "console.log('Duplicate order blocked correctly — 409 returned');"
                ]
              }
            }
          ]
        },
        {
          "name": "Get My Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/orders", "host": ["{{base_url}}"], "path": ["api", "orders"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns array', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "pm.test('Has at least 1 order', () => pm.expect(pm.response.json().length).to.be.greaterThan(0));",
                  "console.log('Total orders:', pm.response.json().length);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/api/orders/{{order_id}}", "host": ["{{base_url}}"], "path": ["api", "orders", "{{order_id}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Correct order returned', () => pm.expect(pm.response.json()._id).to.eql(pm.collectionVariables.get('order_id')));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5 - Security Tests",
      "item": [
        {
          "name": "No Token - Expect 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/orders", "host": ["{{base_url}}"], "path": ["api", "orders"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 without token', () => pm.response.to.have.status(401));",
                  "pm.test('Error message present', () => pm.expect(pm.response.json().message).to.be.a('string'));",
                  "console.log('Correctly blocked:', pm.response.json().message);"
                ]
              }
            }
          ]
        },
        {
          "name": "Fake Token - Expect 401",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer thisisafaketoken123" }],
            "url": { "raw": "{{base_url}}/api/orders", "host": ["{{base_url}}"], "path": ["api", "orders"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 with fake token', () => pm.response.to.have.status(401));",
                  "pm.test('Invalid token message', () => pm.expect(pm.response.json().message).to.include('Invalid'));",
                  "console.log('Correctly rejected fake token');"
                ]
              }
            }
          ]
        },
        {
          "name": "Create Order - No Items (expect 400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": []\n}"
            },
            "url": { "raw": "{{base_url}}/api/orders", "host": ["{{base_url}}"], "path": ["api", "orders"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 400 for empty items', () => pm.response.to.have.status(400));",
                  "console.log('Validation working:', pm.response.json().message);"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
